# ========================================================
# Frontend (Vue SPA) & Backend Configuration
# ========================================================

# Port Server Frontend (Vite)
# Ubah port ini jika ingin menjalankan FE di port lain (misal: 3000, 5173, 8000)
VITE_PORT=5173

# Port Server Production (Nginx) jika menggunakan Docker Compose profile 'prod'
VITE_PROD_PORT=80

# Domain / URL Backend (Golang REST API)
# Digunakan untuk proxy development dan target endpoint API:
# - Lokal di Windows Host: http://127.0.0.1:8080
# - Di dalam Docker Desktop: otomatis dialihkan ke http://host.docker.internal:8080
#   (atau bisa diisi host container seperti http://test-golang-api:8080 atau https://api.domainanda.com)
VITE_BACKEND_URL=http://127.0.0.1:8080

# Opsional: Jika ingin melakukan request langsung tanpa proxy Vite, isi baseURL di bawah ini.
# Biarkan kosong jika ingin menggunakan Vite / Nginx Proxy (rekomendasi untuk cegah CORS).
VITE_API_BASE_URL=

# Judul Aplikasi
VITE_APP_TITLE=Golang API Frontend Tester
