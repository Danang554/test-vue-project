# ========================================================
# Frontend (Vue SPA) & Backend Configuration
# ========================================================

# Port Server Frontend (Vite)
# Ubah port ini jika ingin menjalankan FE di port lain (misal: 3000, 5173, 8000)
VITE_PORT=5173

# Domain / URL Backend (Golang REST API)
# Digunakan untuk proxy development dan target endpoint API
# Contoh: http://127.0.0.1:8080 atau http://localhost:8080 atau https://api.domainanda.com
VITE_BACKEND_URL=http://127.0.0.1:8080

# Opsional: Jika ingin melakukan request langsung tanpa proxy Vite, isi baseURL di bawah ini.
# Biarkan kosong jika ingin menggunakan Vite Dev Proxy (rekomendasi untuk cegah CORS).
VITE_API_BASE_URL=

# Judul Aplikasi
VITE_APP_TITLE=Golang API Frontend Tester
